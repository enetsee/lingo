## lib/ocaml/parser.ml  (5)
lib/ocaml/parser.ml:51     sbr      drop 1 of 1
lib/ocaml/parser.ml:69     extreme  instr_kinds -> 0
lib/ocaml/parser.ml:128    sbr      drop 1 of 2
lib/ocaml/parser.ml:128    sbr      drop 2 of 2
lib/ocaml/parser.ml:165    ror      >= -> >

# [holds] at :51 has no caller. The three in [words] and its helper are the
# width of a recovery set: it is the whole plan's highest kind divided by 63,
# so a bound that comes out lower still gives the same word count on every
# grammar in the corpus. :165 drops kind 0 from a packed set, and no set in the
# corpus holds it.

## lib/ocaml/lexer.ml  (4)
lib/ocaml/lexer.ml:170     ror      > -> >=
lib/ocaml/lexer.ml:186     ror      < -> <=
lib/ocaml/lexer.ml:211     ror      <= -> <
lib/ocaml/lexer.ml:377     aor      * -> /

# :170 is [bits_for], which loses a bit where the count is an exact power of
# two, and no grammar's is. :186 sends state 0 nowhere, and no cell in the
# corpus transitions to it. :211 moves the first segment above the ASCII table,
# which only matters where a segment starts at exactly U+0080, and none does.
# :377 cannot be killed by anything: [Core.Lexer.initial] is 0, so the initial
# row is 0 whether the class count multiplies it or divides it.

