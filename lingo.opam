# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A grammar toolkit: lossless recovering parsers, formatters, editors"
description:
  "Takes a grammar as a value -- tokens, productions with typed children, an optional Pratt expression block -- and emits a lossless recovering parser, a pretty-printer, a lexer, typed views, and editor integrations."
maintainer: ["Michael Thomas <mthomas180@gmail.com>"]
authors: ["Michael Thomas <mthomas180@gmail.com>"]
license: "MIT"
homepage: "https://github.com/enetsee/lingo"
bug-reports: "https://github.com/enetsee/lingo/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.0"}
  "lingo_runtime"
  "ucharset"
  "redfa"
  "bolts"
  "ppxlib"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/enetsee/lingo.git"
x-maintenance-intent: ["(latest)"]
