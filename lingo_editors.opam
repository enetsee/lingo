# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "TextMate and tree-sitter backends for lingo"
description:
  "Renders a lingo grammar to a .tmLanguage.json TextMate grammar and to a tree-sitter grammar.js. Separate from the lingo package because yojson is its dependency and nothing else needs it."
maintainer: ["Michael Thomas <mthomas180@gmail.com>"]
authors: ["Michael Thomas <mthomas180@gmail.com>"]
license: "MIT"
homepage: "https://github.com/enetsee/lingo"
bug-reports: "https://github.com/enetsee/lingo/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.0"}
  "lingo"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/enetsee/lingo.git"
x-maintenance-intent: ["(latest)"]
