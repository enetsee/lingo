# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Runtime linked by lingo-generated parsers and formatters"
description:
  "The cursor, builder, diagnostics, recovery, and the table-driven plan and layout engines that generated code calls into. Depends on siesta and handsome and nothing else of ours. A generated parser can link it and leave the code generator out of the build graph."
maintainer: ["Michael Thomas <mthomas180@gmail.com>"]
authors: ["Michael Thomas <mthomas180@gmail.com>"]
license: "MIT"
homepage: "https://github.com/enetsee/lingo"
bug-reports: "https://github.com/enetsee/lingo/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2"}
  "siesta"
  "handsome"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/enetsee/lingo.git"
x-maintenance-intent: ["(latest)"]
