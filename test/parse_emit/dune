; The emitted parsers. They are generated here, compiled here, and run
; against the interpreter, which is the specification.

(executable
 (name gen)
 (modules gen)
 (libraries lingo.core lingo.plan lingo.ocaml lingo_grammars))

(rule
 (with-stdout-to
  sexp_parser.ml
  (run ./gen.exe sexp parser)))

(rule
 (with-stdout-to
  sexp_parser.mli
  (run ./gen.exe sexp mli)))

(rule
 (with-stdout-to
  json_parser.ml
  (run ./gen.exe json parser)))

(rule
 (with-stdout-to
  json_parser.mli
  (run ./gen.exe json mli)))

(rule
 (with-stdout-to
  calc_parser.ml
  (run ./gen.exe calc parser)))

(rule
 (with-stdout-to
  calc_parser.mli
  (run ./gen.exe calc mli)))

(rule
 (with-stdout-to
  rassoc_parser.ml
  (run ./gen.exe rassoc parser)))

(rule
 (with-stdout-to
  rassoc_parser.mli
  (run ./gen.exe rassoc mli)))

(rule
 (with-stdout-to
  postfix_parser.ml
  (run ./gen.exe postfix parser)))

(rule
 (with-stdout-to
  postfix_parser.mli
  (run ./gen.exe postfix mli)))

(rule
 (with-stdout-to
  shapes_parser.ml
  (run ./gen.exe shapes parser)))

(rule
 (with-stdout-to
  shapes_parser.mli
  (run ./gen.exe shapes mli)))

(rule
 (with-stdout-to
  unicode_parser.ml
  (run ./gen.exe unicode parser)))

(rule
 (with-stdout-to
  unicode_parser.mli
  (run ./gen.exe unicode mli)))

(rule
 (with-stdout-to
  recovery_parser.ml
  (run ./gen.exe recovery parser)))

(rule
 (with-stdout-to
  recovery_parser.mli
  (run ./gen.exe recovery mli)))

; The residual tables, beside the parser they describe.

(rule
 (with-stdout-to
  sexp_residual.ml
  (run ./gen.exe sexp residual)))

(rule
 (with-stdout-to
  sexp_residual.mli
  (run ./gen.exe sexp residual-mli)))

(rule
 (with-stdout-to
  json_residual.ml
  (run ./gen.exe json residual)))

(rule
 (with-stdout-to
  json_residual.mli
  (run ./gen.exe json residual-mli)))

(rule
 (with-stdout-to
  calc_residual.ml
