  recovery_residual.mli
  (run ./gen.exe recovery residual-mli)))

; [emitted_parsers] links lingo_runtime and nothing else of ours, so a
; generated parser that reached for lingo.plan or lingo.core would not build.

(library
 (name emitted_parsers)
 (modules
  sexp_parser
  json_parser
  calc_parser
  rassoc_parser
  postfix_parser
  shapes_parser
  unicode_parser
  recovery_parser
  sexp_residual
  json_residual
  calc_residual
  rassoc_residual
  postfix_residual
  shapes_residual
  unicode_residual
  recovery_residual)
 (libraries lingo_runtime))

; law_ahead reads the emitted tables back and compares them with the plan they
; came from. Whether those tables are right is test/laws/law_residual part (h).

(tests
 (names law_ahead)
 (modules law_ahead)
 (libraries
  emitted_parsers
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.plan
  lingo_grammars
  lingo_runtime
  siesta))

(tests
 (names law_parse)
 (modules law_parse)
 (libraries
  emitted_parsers
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.plan
  lingo_grammars
  lingo_runtime
  siesta
  sweep))
