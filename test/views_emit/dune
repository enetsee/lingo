(library
 (name emitted_views)
 (modules
  sexp_views
  json_views
  calc_views
  rassoc_views
  postfix_views
  shapes_views
  unicode_views
  recovery_views
  comments_views
  rust_views
  effekt_views
  wide_views
  ml_views
  nested_views)
 (libraries siesta))

(library
 (name emitted_slots)
 (modules
  sexp_slots
  json_slots
  calc_slots
  rassoc_slots
  postfix_slots
  shapes_slots
  unicode_slots
  recovery_slots
  comments_slots
  rust_slots
  effekt_slots
  wide_slots
  ml_slots
  nested_slots)
 (libraries siesta))

; law_views part (c) reads the emitted modules as files and asks [lingo.ocaml]
; for them again, so the generator is covered at run time as well.

(tests
 (names law_views)
 (modules law_views)
 (deps
  (glob_files *_views.ml)
  (glob_files *_views.mli))
 (libraries
  law
  emitted_slots
  nested_grammar
  ppxlib
  lingo.fuzz
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.ocaml
  lingo.plan
  lingo_grammars
  lingo_runtime
  siesta
  sweep))

(test
 (name test_views)
 (modules test_views)
 (libraries
  law
  emitted_parsers
  emitted_views
  nested_grammar
  lingo.interp
  lingo.plan
  lex
  lingo.core
  lingo_grammars
  siesta))
