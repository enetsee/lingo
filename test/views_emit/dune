; The emitted views. They are generated here and compiled twice: once with
; their interface, linking siesta alone, and once without, for the law.

(executable
 (name gen)
 (modules gen)
 (libraries lingo.core lingo.ocaml lingo_grammars nested_grammar))

(rule
 (with-stdout-to
  sexp_views.ml
  (run ./gen.exe sexp views)))

(rule
 (with-stdout-to
  sexp_views.mli
  (run ./gen.exe sexp mli)))

(rule
 (copy sexp_views.ml sexp_slots.ml))

(rule
 (with-stdout-to
  json_views.ml
  (run ./gen.exe json views)))

(rule
 (with-stdout-to
  json_views.mli
  (run ./gen.exe json mli)))

(rule
 (copy json_views.ml json_slots.ml))

