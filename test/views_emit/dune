; The rewrite modules, compiled the same two ways. The copy without the
; interface keeps [probe], which law_congr runs every congruence through.

(library
 (name emitted_rewrite)
 (modules
  sexp_rewrite
  json_rewrite
  calc_rewrite
  rassoc_rewrite
  postfix_rewrite
  shapes_rewrite
  unicode_rewrite
  recovery_rewrite
  comments_rewrite
  rust_rewrite
  effekt_rewrite
  wide_rewrite
  ml_rewrite
  nested_rewrite
  ties_rewrite)
 (libraries emitted_views lingo_runtime siesta))

(library
 (name emitted_probe)
 (modules
  sexp_probe
  json_probe
  calc_probe
  rassoc_probe
  postfix_probe
  shapes_probe
  unicode_probe
  recovery_probe
  comments_probe
  rust_probe
  effekt_probe
  wide_probe
  ml_probe
  nested_probe
  ties_probe)
 (libraries emitted_views lingo_runtime siesta))

; law_views part (c) reads the emitted modules as files and asks [lingo.ocaml]
; for them again, so the generator is covered at run time as well.

(tests
 (names law_views)
 (modules law_views)
 (deps
  (glob_files *_views.ml)
  (glob_files *_views.mli))
 (libraries
  law
  emitted_slots
  nested_grammar
  ppxlib
  lingo.fuzz
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.ocaml
  lingo.plan
  lingo_grammars
  lingo_runtime
  siesta
  sweep))

(test
 (name test_views)
 (modules test_views)
 (libraries
  law
  emitted_parsers
  emitted_views
  nested_grammar
  lingo.interp
  lingo.plan
  lex
  lingo.core
  lingo_grammars
  siesta))

; law_congr runs every generated congruence over every tree the interpreter
; parses from test/inputs, and reads the expected node from the facts.

(tests
 (names law_congr)
 (modules law_congr)
 (libraries
  law
  emitted_probe
  emitted_views
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.plan
  lingo_grammars
  lingo_runtime
  lingo_runtime.ir
  siesta))

; Tokens as the formatter settles them, for the laws that compare two
; formatted trees.

(library
 (name body_tokens)
 (modules body_tokens)
 (libraries lingo.core siesta))

; law_make rebuilds every production node with its generated [make], then
; formats and parses the tree again. It needs the layout and the shape oracle
; as well as the parse.

(tests
 (names law_make)
 (modules law_make)
 (libraries
  law
  body_tokens
  emitted_probe
  emitted_views
  inputs
  lex
  lingo.core
  lingo.fuzz
  lingo.interp
  lingo.layout
  lingo.plan
  lingo_grammars
  lingo_runtime
  lingo_runtime.ir
  siesta))

; law_parens takes every bracketing atom out and builds every role again,
; then checks that the constructors put back what the parse needs and
; nothing more.

(tests
 (names law_parens)
 (modules law_parens)
 (libraries
  law
  ties_grammar
  emitted_probe
  emitted_rewrite
  emitted_views
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.layout
  lingo.plan
  lingo_grammars
  lingo_runtime
  lingo_runtime.ir
  siesta))

; law_edits deletes and inserts every element of every repeated child in the
; corpus, and reads the child back from the formatted and parsed tree.

(tests
 (names law_edits)
 (modules law_edits)
 (libraries
  law
  emitted_probe
  emitted_views
  inputs
  lex
  lingo.core
  lingo.interp
  lingo.layout
  lingo.plan
  lingo_grammars
  lingo_runtime
  lingo_runtime.ir
  siesta))

; law_apply edits the items of every corpus file, applies the splices to the
; old text, and parses and formats the result.

(tests
 (names law_apply)
 (modules law_apply)
 (libraries
  law
  body_tokens
  emitted_probe
  emitted_rewrite
  emitted_views
  inputs
  lex
  lingo.core
  lingo.fuzz
  lingo.interp
  lingo.layout
  lingo.plan
  lingo_grammars
  lingo_runtime
  lingo_runtime.ir
  siesta))
