; [emitted] links lingo_runtime and nothing else of ours, so a generated
; lexer that reached for redfa or ucharset would not build.

(library
 (name emitted)
 (modules
  sexp_lexer
  json_lexer
  calc_lexer
  rassoc_lexer
  postfix_lexer
  shapes_lexer
  unicode_lexer
  sexp_match
  json_match
  calc_match
  rassoc_match
  postfix_match
  shapes_match
  unicode_match
  recovery_lexer
  comments_lexer
  rust_lexer
  effekt_lexer
  wide_lexer
  ml_lexer
  recovery_match
  comments_match
  rust_match
  effekt_match
  wide_match
  ml_match)
 (libraries lingo_runtime))

; law_lex part (f) reads the emitted modules as files and asks [lingo.ocaml]
; for them again, so the generator itself is covered at run time rather than
; only at build time.

(tests
 (names law_lex)
 (modules law_lex)
 (deps
  (glob_files *_lexer.ml)
  (glob_files *_lexer.mli)
  (glob_files *_match.ml))
 (libraries
  law
  emitted
  lex
  lingo.core
  lingo.ocaml
  lingo_grammars
  lingo_runtime
  inputs))
