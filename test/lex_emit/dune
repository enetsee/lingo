; The emitted lexers, in both shapes. They are generated here, compiled here,
; and run against the lexer test/lex walks over the same automaton.

(executable
 (name gen)
 (modules gen)
 (libraries lingo.core lingo.ocaml lingo_grammars))

(rule
 (with-stdout-to
  sexp_lexer.ml
  (run ./gen.exe sexp table)))

(rule
 (with-stdout-to
  sexp_lexer.mli
  (run ./gen.exe sexp mli)))

(rule
 (with-stdout-to
  sexp_match.ml
  (run ./gen.exe sexp match)))

(rule
 (with-stdout-to
  sexp_match.mli
  (run ./gen.exe sexp mli)))

(rule
 (with-stdout-to
  json_lexer.ml
  (run ./gen.exe json table)))

(rule
 (with-stdout-to
