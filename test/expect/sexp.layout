; 0 N_FILE
; 1 N_SEXP
; 2 N_GROUP
; 3 T_LPAREN
; 4 T_RPAREN
; 5 T_IDENT
; 6 T_NUMBER
; 7 T_WS
; 8 N_FILE_HOLE
; 9 N_SEXP_HOLE
; 10 N_GROUP_HOLE
; 11 T_ERROR
; 12 N_ERROR
; 13 N_MISSING
; 14 T_UNTERMINATED
(layout
  (token 3)
  (token 4)
  (token 5 before after)
  (token 6 before after)
  (token 7 before after reformat)
  (token 11)
  (token 14)
  (rule 0 File 0
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 1) (before flat) (between flat))
  )
  (rule 1 Sexp 1
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 2 5 6) (before flat) (between flat))
  )
  (rule 2 Group 2
    (frame delimited 3 4)
    (body fit) (inner fit) (indent 2) (edge-before true) (edge-after true)
    (slot (kinds 1) repeats (before flat) (between fit))
  )
)
