; 0 N_PROGRAM
; 1 N_DECL
; 2 N_LET
; 3 N_INIT
; 4 N_NAMES
; 5 N_BLOCK
; 6 N_TUPLE
; 7 T_LET
; 8 T_LBRACE
; 9 T_RBRACE
; 10 T_LPAREN
; 11 T_RPAREN
; 12 T_SEMI
; 13 T_COMMA
; 14 T_EQUALS
; 15 T_AT
; 16 T_END
; 17 T_NAME
; 18 T_WS
; 19 N_PROGRAM_HOLE
; 20 N_DECL_HOLE
; 21 N_LET_HOLE
; 22 N_INIT_HOLE
; 23 N_NAMES_HOLE
; 24 N_BLOCK_HOLE
; 25 N_TUPLE_HOLE
; 26 T_ERROR
; 27 N_ERROR
; 28 N_MISSING
; 29 T_UNTERMINATED
(layout
  (token 7 before after)
  (token 8 before)
  (token 9 after)
  (token 10 before)
  (token 11 after)
  (token 12)
  (token 13)
  (token 14 before after)
  (token 15)
  (token 16 before after)
  (token 17 before after)
  (token 18 before after reformat)
  (token 26)
  (token 29)
  (rule 0 Program 0
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 1) repeats (before flat) (between fit))
  )
  (rule 1 Decl 1
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 2 5 6) (before flat) (between flat))
  )
  (rule 2 Let 2
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 7) (before flat) (between flat))
    (slot (kinds 17) (before fit) (between fit))
    (slot (kinds 15) (before fit) (between fit))
    (slot (kinds 3) (before fit) (between fit))
  )
  (rule 3 Init 3
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 14) (before flat) (between flat))
    (slot (kinds 4) (before fit) (between fit))
  )
  (rule 4 Names 4
    (frame separated (sep 13 never never))
    (body fit) (inner fit) (indent 2)
    (slot (kinds 17) repeats (before flat) (between fit))
  )
  (rule 5 Block 5
    (frame delimited 8 9 (sep 12 never always))
    (body fit) (inner fit) (indent 2)
    (slot (kinds 1) repeats (before flat) (between fit))
  )
  (rule 6 Tuple 6
    (frame delimited 10 11)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 4) (before flat) (between flat) handed)
  )
)
