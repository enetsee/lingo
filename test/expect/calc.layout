; 0 N_FILE
; 1 N_PARENS
; 2 T_LPAREN
; 3 T_RPAREN
; 4 T_PLUS
; 5 T_MINUS
; 6 T_STAR
; 7 T_SLASH
; 8 T_INT
; 9 T_WS
; 10 N_EXPR
; 11 N_EXPR_BIN
; 12 N_EXPR_PREFIX
; 13 N_FILE_HOLE
; 14 N_PARENS_HOLE
; 15 N_EXPR_HOLE
; 16 T_ERROR
; 17 N_ERROR
; 18 N_MISSING
; 19 T_UNTERMINATED
(layout
  (token 2)
  (token 3)
  (token 4 before after)
  (token 5 before after)
  (token 6 before after)
  (token 7 before after)
  (token 8 before after)
  (token 9 before after reformat)
  (token 16)
  (token 19)
  (rule 0 File 0
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 10 11 12 15) (before flat) (between flat))
  )
  (rule 1 Parens 1
    (frame delimited 2 3)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 10 11 12 15) (before flat) (between flat))
  )
  (rule 2 Expr 10
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 8) (before flat) (between flat))
  )
  (rule 3 ExprBin 11
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 10 11 12 15) (before flat) (between flat))
    (slot (kinds 4 5 6 7) (before flat) (between flat))
    (slot (kinds 10 11 12 15) (before fit) (between fit))
  )
  (rule 4 ExprPrefix 12
    (frame plain)
    (body fit) (inner fit) (indent 2)
    (slot (kinds 5) (before flat) (between flat))
    (slot (kinds 10 11 12 15) (before flat) (between flat))
  )
)
