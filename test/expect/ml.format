"let map (f : int -> int) (xs : int) : int =\n  f(~by: 1, xs) {\n    xs.head;\n    !xs;\n  };"
@80
  | let map (f: int -> int) (xs: int): int = f(~by:1, xs) { xs.head; !xs; };
@16
  | let map (f: int
  |     -> int) (xs: int): int =
  |   f(~by:1,
  |     xs,
  |   ) { xs.head;
  |     !xs;
  |   };
