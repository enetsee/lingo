N_PROGRAM
  0 may-end
    next T_LET T_LBRACE
    on N_DECL -> 0
    on N_ERROR -> 0

N_DECL
  0
    next T_LET T_LBRACE
    on N_LET N_BLOCK N_DECL_HOLE -> 1
  1 may-end

N_LET
  0
    next T_LET
    on T_LET -> 1
    on T_NAME -> 2
    on T_AT -> 3
    on N_INIT -> 4
  1
    next T_NAME
    on T_NAME -> 2
    on T_AT -> 3
    on N_INIT -> 4
  2 may-end
    next T_EQUALS T_AT
    on T_AT -> 3
    on N_INIT -> 4
  3 may-end
    next T_EQUALS
    on N_INIT -> 4
  4 may-end

N_INIT
  0
    next T_EQUALS
    on T_EQUALS -> 1
    on N_NAMES N_INIT_HOLE -> 2
  1
    next T_NAME
    on N_NAMES N_INIT_HOLE -> 2
  2 may-end

N_NAMES
  0
    next T_NAME
    on T_NAME -> 1
    on T_COMMA -> 2
  1 may-end
    next T_COMMA
    on T_COMMA -> 2
  2
    next T_NAME
    on T_NAME -> 1

N_BLOCK
  0
    next T_LBRACE
    on T_LBRACE -> 1
    on N_DECL -> 2
    on N_ERROR -> 1
    on T_RBRACE -> 4
  1
    next T_LET T_LBRACE T_RBRACE
    on N_DECL -> 2
    on N_ERROR -> 1
    on T_RBRACE -> 4
  2
    next T_RBRACE T_SEMI
    on T_SEMI -> 3
    on N_ERROR -> 1
    on T_RBRACE -> 4
  3
    next T_LET T_LBRACE T_RBRACE
    on N_DECL -> 2
    on N_ERROR -> 1
    on T_RBRACE -> 4
  4 may-end

