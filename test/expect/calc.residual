N_EXPR
  0
    next T_LPAREN T_MINUS T_INT
    on T_INT -> 1
  1 may-end
    next T_PLUS T_MINUS T_STAR T_SLASH

N_EXPR_HOLE
  0
    next T_LPAREN T_MINUS T_INT

N_EXPR_PREFIX
  0
    next T_LPAREN T_MINUS T_INT
    on T_MINUS -> 1
  1
    next T_LPAREN T_MINUS T_INT
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_EXPR_HOLE -> 2
  2 may-end
    next T_PLUS T_MINUS T_STAR T_SLASH

N_EXPR_BIN
  0
    next T_LPAREN T_MINUS T_INT
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_EXPR_HOLE -> 1
  1 may-end
    next T_PLUS T_MINUS T_STAR T_SLASH
    on T_PLUS T_MINUS T_STAR T_SLASH -> 2
  2
    next T_LPAREN T_MINUS T_INT
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_EXPR_HOLE -> 3
  3 may-end
    next T_PLUS T_MINUS T_STAR T_SLASH

N_FILE
  0
    next T_LPAREN T_MINUS T_INT
    on N_PARENS -> 2
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_FILE_HOLE N_EXPR_HOLE -> 1
  1 may-end
  2 may-end
    next T_PLUS T_MINUS T_STAR T_SLASH

N_PARENS
  0
    next T_LPAREN
    on T_LPAREN -> 1
    on N_PARENS -> 4
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_PARENS_HOLE N_EXPR_HOLE -> 2
    on T_RPAREN -> 3
  1
    next T_LPAREN T_MINUS T_INT
    on N_PARENS -> 4
    on N_PARENS N_EXPR N_EXPR_BIN N_EXPR_PREFIX N_PARENS_HOLE N_EXPR_HOLE -> 2
    on T_RPAREN -> 3
  2
    next T_RPAREN
    on T_RPAREN -> 3
  3 may-end
  4
    next T_RPAREN T_PLUS T_MINUS T_STAR T_SLASH
    on T_RPAREN -> 3

