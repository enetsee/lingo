; The lowering's output, recorded. Each grammar is its own file, so a change to
; one does not move the bytes of the others.

(executable
 (name dump_plan)
 (modules dump_plan)
 (libraries lingo.plan lingo.core lingo_grammars lingo_runtime.ir))

; The trees and diagnostics a parse makes of a broken input. [lex] is the
; laws' own, over the facts' automaton, so a grammar needs no lexer of its own.

(executable
 (name dump_parse)
 (modules dump_parse)
 (libraries
  lingo.plan
  lingo.interp
  lingo.core
  lingo_grammars
  lingo_runtime
  lex
  siesta))

(rule
 (with-stdout-to
  sexp.plan.actual
  (run ./dump_plan.exe sexp)))

(rule
 (with-stdout-to
  json.plan.actual
  (run ./dump_plan.exe json)))

(rule
 (with-stdout-to
  calc.plan.actual
  (run ./dump_plan.exe calc)))

(rule
 (with-stdout-to
  rassoc.plan.actual
  (run ./dump_plan.exe rassoc)))

(rule
 (with-stdout-to
  postfix.plan.actual
  (run ./dump_plan.exe postfix)))

(rule
 (with-stdout-to
  shapes.plan.actual
  (run ./dump_plan.exe shapes)))

(rule
 (with-stdout-to
  unicode.plan.actual
  (run ./dump_plan.exe unicode)))

(rule
 (alias runtest)
 (action
  (diff sexp.plan sexp.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff json.plan json.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff calc.plan calc.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff rassoc.plan rassoc.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff postfix.plan postfix.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff shapes.plan shapes.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff unicode.plan unicode.plan.actual)))

(rule
 (with-stdout-to
  sexp.parse.actual
  (run ./dump_parse.exe sexp)))

(rule
 (alias runtest)
 (action
  (diff sexp.parse sexp.parse.actual)))

(rule
 (with-stdout-to
  json.parse.actual
  (run ./dump_parse.exe json)))

(rule
 (alias runtest)
 (action
  (diff json.parse json.parse.actual)))

(rule
 (with-stdout-to
  shapes.parse.actual
  (run ./dump_parse.exe shapes)))

(rule
 (alias runtest)
 (action
  (diff shapes.parse shapes.parse.actual)))

(rule
 (with-stdout-to
  calc.parse.actual
  (run ./dump_parse.exe calc)))

(rule
 (alias runtest)
 (action
  (diff calc.parse calc.parse.actual)))

(rule
 (with-stdout-to
  postfix.parse.actual
  (run ./dump_parse.exe postfix)))

(rule
 (alias runtest)
 (action
  (diff postfix.parse postfix.parse.actual)))
