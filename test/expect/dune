; The lowering's output, recorded. Each grammar is its own file, so a change to
; one does not move the bytes of the others.

(executable
 (name dump_plan)
 (modules dump_plan)
 (libraries lingo.plan lingo.core lingo_grammars lingo_runtime.ir))

(rule
 (with-stdout-to
  sexp.plan.actual
  (run ./dump_plan.exe sexp)))

(rule
 (with-stdout-to
  json.plan.actual
  (run ./dump_plan.exe json)))

(rule
 (with-stdout-to
  calc.plan.actual
  (run ./dump_plan.exe calc)))

(rule
 (with-stdout-to
  rassoc.plan.actual
  (run ./dump_plan.exe rassoc)))

(rule
 (with-stdout-to
  postfix.plan.actual
  (run ./dump_plan.exe postfix)))

(rule
 (with-stdout-to
  shapes.plan.actual
  (run ./dump_plan.exe shapes)))

(rule
 (with-stdout-to
  unicode.plan.actual
  (run ./dump_plan.exe unicode)))

(rule
 (alias runtest)
 (action
  (diff sexp.plan sexp.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff json.plan json.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff calc.plan calc.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff rassoc.plan rassoc.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff postfix.plan postfix.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff shapes.plan shapes.plan.actual)))

(rule
 (alias runtest)
 (action
  (diff unicode.plan unicode.plan.actual)))
