----------------------------------------------------------------------
"[a, b]"
@80
  | [a, b]
@16
  | [a, b]
----------------------------------------------------------------------
"[a.b, 1]"
@80
  | [a.b, 1]
@16
  | [a.b, 1]
----------------------------------------------------------------------
"[]"
@80
  | []
@16
  | []
----------------------------------------------------------------------
"[[a], [b, c]]"
@80
  | [[a],[b, c]]
@16
  | [[a],[b, c]]
----------------------------------------------------------------------
"[ // first\n  a, b ]"
@80
  | [// first
  |   a,
  |   b,
  | ]
@16
  | [// first
  |   a,
  |   b,
  | ]
----------------------------------------------------------------------
"[a, // trailing\n  b ]"
@80
  | [
  |   a, // trailing
  |   b,
  | ]
@16
  | [
  |   a, // trailing
  |   b,
  | ]
----------------------------------------------------------------------
"[a /* mid */, b]"
@80
  | [a /* mid */, b]
@16
  | [a /* mid */, b]
----------------------------------------------------------------------
"[aaaa, bbbb, cccc, dddd]"
@80
  | [aaaa, bbbb, cccc, dddd]
@16
  | [
  |   aaaa,
  |   bbbb,
  |   cccc,
  |   dddd,
  | ]
----------------------------------------------------------------------
"[a] // after"
@80
  | [a]// after
@16
  | [a]// after
----------------------------------------------------------------------
"[1 . 5]"
@80
  | [1. 5]
@16
  | [1. 5]
----------------------------------------------------------------------
"[a, b,]"
@80
  | [
  |   a,
  |   b,
  | ]
@16
  | [
  |   a,
  |   b,
  | ]
----------------------------------------------------------------------
"[[a, b,], c]"
@80
  | [
  |   [
  |     a,
  |     b,
  |   ],
  |   c,
  | ]
@16
  | [
  |   [
  |     a,
  |     b,
  |   ],
  |   c,
  | ]
----------------------------------------------------------------------
"[1 .5]"
@80
  | [1. 5]
@16
  | [1. 5]
----------------------------------------------------------------------
"[a"   (recovered)
@80
  | [a
@16
  | [a
----------------------------------------------------------------------
"[a, // x"   (recovered)
@80
  | [
  |   a, // x
@16
  | [
  |   a, // x
----------------------------------------------------------------------
"[a,, b]"   (recovered)
@80
  | [
  |     a,
  |   ,
  |   b
  |   ]
@16
  | [
  |     a,
  |   ,
  |   b
  |   ]
----------------------------------------------------------------------
"[. a]"   (recovered)
@80
  | [.a]
@16
  | [.a]
----------------------------------------------------------------------
"[a b]"   (recovered)
@80
  | [a b]
@16
  | [a b]
----------------------------------------------------------------------
"/* open"   (recovered)
@80
  | /* open
@16
  | /* open
----------------------------------------------------------------------
"[a] junk"   (recovered)
@80
  | [a]junk
@16
  | [a]junk
----------------------------------------------------------------------
"[a/* mid *//* mid */.]"   (recovered)
@80
  | [a /* mid */ /* mid */.]
@16
  | [
  |   a /* mid */ /* mid */.,
  | ]
