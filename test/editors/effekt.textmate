{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Effekt",
  "scopeName": "source.effekt",
  "patterns": [
    { "include": "#file" },
    { "include": "#trivia" },
    { "include": "#tokens" }
  ],
  "repository": {
    "file": {
      "patterns": [ { "include": "#module" }, { "include": "#item" } ]
    },
    "module": {
      "name": "meta.module.effekt",
      "begin": "\\bmodule\\b",
      "end": "(?<=;)",
      "beginCaptures": { "0": { "name": "keyword.other.module.effekt" } },
      "patterns": [
        { "include": "#path" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "doc_block": { "patterns": [] },
    "item": {
      "patterns": [
        { "include": "#doc_block" }, { "include": "#definition" }
      ]
    },
    "definition": {
      "patterns": [
        { "include": "#import" },
        { "include": "#def" },
        { "include": "#val_def" },
        { "include": "#var_def" },
        { "include": "#type_def" },
        { "include": "#record" },
        { "include": "#interface" },
        { "include": "#effect" },
        { "include": "#namespace" }
      ]
    },
    "path": {
      "name": "meta.path.effekt",
      "begin": "(?!(?:and|at|box|case|def|do|effect|else|false|fn|if|import|interface|match|module|namespace|record|resume|return|true|try|type|unbox|val|var|while|with)\\b)[A-Z_a-z][0-9A-Z_a-z]*",
      "end": "(?=;)",
      "beginCaptures": { "0": { "name": "variable.other.effekt" } },
      "patterns": [
        { "include": "#path_segment" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "path_segment": {
      "name": "meta.path.segment.effekt",
      "match": "(::)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "captures": {
        "1": { "name": "punctuation.separator.effekt" },
        "2": { "name": "variable.other.effekt" }
      }
    },
    "import": {
      "name": "meta.import.effekt",
      "begin": "\\bimport\\b",
      "end": "(?<=;)",
      "beginCaptures": { "0": { "name": "keyword.other.import.effekt" } },
      "patterns": [
        { "include": "#path" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "param": {
      "name": "meta.param.effekt",
      "begin": "(?!(?:and|at|box|case|def|do|effect|else|false|fn|if|import|interface|match|module|namespace|record|resume|return|true|try|type|unbox|val|var|while|with)\\b)[A-Z_a-z][0-9A-Z_a-z]*",
      "end": "(?=\\)|,)",
      "beginCaptures": { "0": { "name": "variable.other.effekt" } },
      "patterns": [
        { "include": "#type" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "params": {
      "name": "meta.params.effekt",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.effekt" }
      },
      "patterns": [
        { "include": "#param" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "def": {
      "name": "meta.def.effekt",
      "begin": "(?=(\\bdef\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*))",
      "end": "(?!\\G)(?<=;)",
      "patterns": [
        {
          "begin": "\\G(\\bdef\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
          "end": "=(?!=|>)",
          "endCaptures": { "0": { "name": "punctuation.separator.effekt" } },
          "beginCaptures": {
            "1": { "name": "storage.type.def.effekt" },
            "2": { "name": "variable.other.effekt" }
          },
          "patterns": [
            { "include": "#params" },
            { "include": "#type" },
            { "include": "#trivia" },
            { "include": "#tokens" }
          ]
        },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "val_def": {
      "name": "meta.val.def.effekt",
      "begin": "(?=(\\bval\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*))",
      "end": "(?!\\G)(?<=;)",
      "patterns": [
        {
          "begin": "\\G(\\bval\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
          "end": "=(?!=|>)",
          "endCaptures": { "0": { "name": "punctuation.separator.effekt" } },
          "beginCaptures": {
            "1": { "name": "keyword.control.val.effekt" },
            "2": { "name": "variable.other.effekt" }
          },
          "patterns": [
            { "include": "#type" },
            { "include": "#trivia" },
            { "include": "#tokens" }
          ]
        },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "var_def": {
      "name": "meta.var.def.effekt",
      "begin": "(?=(\\bvar\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*))",
      "end": "(?!\\G)(?<=;)",
      "patterns": [
        {
          "begin": "\\G(\\bvar\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
          "end": "=(?!=|>)",
          "endCaptures": { "0": { "name": "punctuation.separator.effekt" } },
          "beginCaptures": {
            "1": { "name": "keyword.control.var.effekt" },
            "2": { "name": "variable.other.effekt" }
          },
          "patterns": [
            { "include": "#type" },
            { "include": "#trivia" },
            { "include": "#tokens" }
          ]
        },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "type_def": {
      "name": "meta.type.def.effekt",
      "begin": "(\\btype\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=;)",
      "beginCaptures": {
        "1": { "name": "storage.type.type.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#type" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "record": {
      "name": "meta.record.effekt",
      "begin": "(\\brecord\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "keyword.other.record.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#params" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "operation": {
      "patterns": [
        { "include": "#params" },
        { "include": "#doc_block" },
        { "include": "#type" }
      ]
    },
    "interface_body": {
      "name": "meta.interface.body.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [
        { "include": "#operation" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "interface": {
      "name": "meta.interface.effekt",
      "begin": "(\\binterface\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "storage.type.interface.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#interface_body" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "effect": {
      "name": "meta.effect.effekt",
      "begin": "(\\beffect\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=;)",
      "beginCaptures": {
        "1": { "name": "storage.type.effect.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#params" },
        { "include": "#type" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "namespace_body": {
      "name": "meta.namespace.body.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [
        { "include": "#item" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "namespace": {
      "name": "meta.namespace.effekt",
      "begin": "(\\bnamespace\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.other.namespace.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#namespace_body" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "type": {
      "patterns": [
        { "include": "#boxed_type" }, { "include": "#boxed_type" }
      ]
    },
    "boxed_type": {
      "patterns": [
        { "include": "#atomic_type" }, { "include": "#capture_set" }
      ]
    },
    "capture_set": {
      "name": "meta.capture.set.effekt",
      "begin": "\\bat\\b",
      "end": "(?<=\\})",
      "beginCaptures": { "0": { "name": "keyword.other.at.effekt" } },
      "patterns": [
        { "include": "#capture_list" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "capture_list": {
      "name": "meta.capture.list.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [ { "include": "#trivia" }, { "include": "#tokens" } ]
    },
    "atomic_type": { "patterns": [ { "include": "#type_args" } ] },
    "type_args": {
      "name": "meta.type.args.effekt",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.effekt" }
      },
      "patterns": [
        { "include": "#type" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "block": {
      "name": "meta.block.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [
        { "include": "#stmt" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "stmt": {
      "patterns": [
        { "include": "#val_def" },
        { "include": "#var_def" },
        { "include": "#def" },
        { "include": "#expr" }
      ]
    },
    "if": {
      "name": "meta.if.effekt",
      "begin": "\\bif\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.control.if.effekt" } },
      "patterns": [
        { "include": "#paren" },
        { "include": "#block" },
        { "include": "#else" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "else": {
      "name": "meta.else.effekt",
      "begin": "\\belse\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.control.else.effekt" } },
      "patterns": [
        { "include": "#block" },
        { "include": "#if" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "while": {
      "name": "meta.while.effekt",
      "begin": "\\bwhile\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.control.while.effekt" } },
      "patterns": [
        { "include": "#paren" },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "paren": {
      "name": "meta.paren.effekt",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.effekt" }
      },
      "patterns": [
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "do": {
      "name": "meta.do.effekt",
      "begin": "(\\bdo\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=\\))",
      "beginCaptures": {
        "1": { "name": "keyword.control.do.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#args" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "args": {
      "name": "meta.args.effekt",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.effekt" }
      },
      "patterns": [
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "return": {
      "name": "meta.return.effekt",
      "begin": "\\breturn\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.control.return.effekt" } },
      "patterns": [
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "resume": {
      "name": "meta.resume.effekt",
      "begin": "\\bresume\\b",
      "end": "(?<=\\))",
      "beginCaptures": { "0": { "name": "keyword.other.resume.effekt" } },
      "patterns": [
        { "include": "#args" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "box": {
      "name": "meta.box.effekt",
      "begin": "\\bbox\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.other.box.effekt" } },
      "patterns": [
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "unbox": {
      "name": "meta.unbox.effekt",
      "begin": "\\bunbox\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.other.unbox.effekt" } },
      "patterns": [
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "fn": {
      "name": "meta.fn.effekt",
      "begin": "(?=\\bfn\\b)",
      "end": "(?!\\G)(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "patterns": [
        {
          "begin": "\\G",
          "end": "=>",
          "endCaptures": { "0": { "name": "punctuation.separator.effekt" } },
          "patterns": [
            {
              "begin": "\\G\\bfn\\b",
              "end": "(?<=\\))",
              "beginCaptures": { "0": { "name": "keyword.other.fn.effekt" } },
              "patterns": [
                { "include": "#params" },
                { "include": "#trivia" },
                { "include": "#tokens" }
              ]
            },
            { "include": "#trivia" },
            { "include": "#tokens" }
          ]
        },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "try": {
      "name": "meta.try.effekt",
      "begin": "\\btry\\b",
      "end": "(?=\\bdef\\b|\\bcase\\b|\\}(?!>)|\\)|,|;|=>)",
      "beginCaptures": { "0": { "name": "keyword.control.try.effekt" } },
      "patterns": [
        { "include": "#block" },
        { "include": "#handler" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "handler": {
      "name": "meta.handler.effekt",
      "begin": "(\\bwith\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.control.with.effekt" },
        "2": { "name": "variable.other.effekt" }
      },
      "patterns": [
        { "include": "#handler_body" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "handler_body": {
      "name": "meta.handler.body.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [
        { "include": "#clause" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "clause": {
      "name": "meta.clause.effekt",
      "begin": "(?=(\\bdef\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*))",
      "end": "(?!\\G)(?=\\bdef\\b|\\}(?!>))",
      "patterns": [
        {
          "begin": "\\G(\\bdef\\b)(?>(?:[\\t\\n\\r ]+)|(?://[^\\n/][^\\n]*|//)|(?:/\\*(?:[^*]|\\*+[^*/])*\\*+/))*([A-Z_a-z][0-9A-Z_a-z]*)",
          "end": "(?<=\\))",
          "beginCaptures": {
            "1": { "name": "storage.type.def.effekt" },
            "2": { "name": "variable.other.effekt" }
          },
          "patterns": [
            { "include": "#params" },
            { "include": "#trivia" },
            { "include": "#tokens" }
          ]
        },
        { "include": "#expr" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "match": {
      "name": "meta.match.effekt",
      "begin": "\\bmatch\\b",
      "end": "(?<=\\})",
      "beginCaptures": { "0": { "name": "keyword.other.match.effekt" } },
      "patterns": [
        { "include": "#paren" },
        { "include": "#match_body" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "match_body": {
      "name": "meta.match.body.effekt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.effekt" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.effekt" }
      },
      "patterns": [
        { "include": "#match_arm" },
        { "include": "#trivia" },
        { "include": "#tokens" }
