{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sexp",
  "scopeName": "source.sexp",
  "patterns": [
    { "include": "#sexp" },
    { "include": "#trivia" },
    { "include": "#tokens" }
  ],
  "repository": {
    "sexp": {
      "patterns": [
        { "match": "[!*+\\-/<-?A-Z_a-z][!*+\\-/-9<-?A-Z_a-z]*" },
        { "match": "-?[0-9]+(?:\\.[0-9]+)?" },
        { "include": "#group" }
      ]
    },
    "group": {
      "name": "meta.group.sexp",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.sexp" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.sexp" }
      },
      "patterns": [
        { "include": "#sexp" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "trivia": { "patterns": [ { "match": "[\\t\\n\\r ]+" } ] },
    "tokens": { "patterns": [] }
  }
}
