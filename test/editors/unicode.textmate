{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Unicode",
  "scopeName": "source.unicode",
  "patterns": [
    { "include": "#doc" }, { "include": "#trivia" }, { "include": "#tokens" }
  ],
  "repository": {
    "doc": {
      "name": "meta.doc.unicode",
      "begin": "«",
      "end": "»",
      "beginCaptures": {
        "0": { "name": "punctuation.section.laquo.begin.unicode" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.raquo.end.unicode" }
      },
      "patterns": [
        { "match": "[a-z\\u{C0}-\\u{FF}\\u{391}-\\u{3C9}]+" },
        { "include": "#trivia" },
        { "include": "#tokens" }
      ]
    },
    "trivia": { "patterns": [ { "match": "[\\t\\n\\r ]+" } ] },
    "tokens": {
      "patterns": [
        { "name": "punctuation.separator.unicode", "match": "→" }
      ]
    }
  }
}
