tokens
  module               keyword.other.module
  import               keyword.other.import
  def                  storage.type.def
  val                  keyword.control.val
  var                  keyword.control.var
  type                 storage.type.type
  record               keyword.other.record
  interface            storage.type.interface
  effect               storage.type.effect
  namespace            keyword.other.namespace
  if                   keyword.control.if
  else                 keyword.control.else
