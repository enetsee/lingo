  with                 keyword.control.with
  case                 keyword.other.case
  match                keyword.other.match
  do                   keyword.control.do
  return               keyword.control.return
  box                  keyword.other.box
  unbox                keyword.other.unbox
  fn                   keyword.other.fn
  at                   keyword.other.at
  and                  keyword.operator.and
  resume               keyword.other.resume
  true                 keyword.other.true
  false                keyword.other.false
  lbrace               punctuation.section.braces.begin
  rbrace               punctuation.section.braces.end
  lparen               punctuation.section.parens.begin
  rparen               punctuation.section.parens.end
  lbracket             punctuation.section.brackets.begin
