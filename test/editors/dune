; The grammars the editor backends are recorded against, with the scopes an
; author would set on each. Shared by the dumps below and by
; test/laws/law_textmate.ml.

(library
 (name editor_corpus)
 (modules editor_corpus)
 (libraries lingo.core lingo.scopes lingo_grammars inputs))

; What each token and each child position is called. All three backends share
; this derivation, so a diff here moves all three.

(executable
 (name dump_scopes)
 (modules dump_scopes)
 (libraries lingo.core lingo.scopes editor_corpus))

; The TextMate grammar itself. One file per grammar, so a change to one does
; not move the bytes of the others.

(executable
 (name dump_textmate)
 (modules dump_textmate)
 (libraries lingo.core lingo.scopes lingo_editors.textmate editor_corpus))

; The tree-sitter grammar and its three query files.

(executable
 (name dump_treesitter)
 (modules dump_treesitter)
 (libraries lingo.core lingo.scopes lingo_editors.treesitter editor_corpus))

; The reference page. It reads the same corpus, because it reads the same
; scopes: a manual and an editor call a keyword the same thing.

(executable
 (name dump_docs)
 (modules dump_docs)
 (libraries lingo.core lingo.scopes lingo.docs editor_corpus))

(rule
 (with-stdout-to
  sexp.scopes.actual
  (run ./dump_scopes.exe sexp)))

(rule
 (alias runtest)
 (action
  (diff sexp.scopes sexp.scopes.actual)))

(rule
 (with-stdout-to
  json.scopes.actual
  (run ./dump_scopes.exe json)))

